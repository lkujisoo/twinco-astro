---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Twinco | Premium Furniture">
  <main class="hero-sections">
    <section class="hero-section" data-section="1">
      <div class="hero-bg" style="background-color: #394957;">
        <div class="hero-placeholder-img">
          <span>现代办公空间全景</span>
        </div>
      </div>
      <div class="hero-content">
        <p class="hero-eyebrow">EST. 2010</p>
        <h1 class="hero-title">专业办公<br>空间方案</h1>
        <p class="hero-desc">十五年专注办公家具研发制造，为欧洲企业打造高效舒适的工作环境</p>
        <a href="#section-2" class="hero-cta">探索更多</a>
      </div>
      <div class="scroll-indicator">
        <span>向下滚动</span>
        <div class="scroll-line"></div>
      </div>
    </section>

    <section class="hero-section" data-section="2" id="section-2">
      <div class="hero-bg" style="background-color: #3D5A80;">
        <div class="hero-placeholder-img">
          <span>生产线 · 品质检测</span>
        </div>
      </div>
      <div class="hero-content hero-content--right">
        <p class="hero-eyebrow">品质</p>
        <h2 class="hero-title">BIFMA 认证<br>欧标品质</h2>
        <p class="hero-desc">全线产品通过 BIFMA / EN 标准测试，从选材到出厂层层把控</p>
      </div>
    </section>

    <section class="hero-section" data-section="3">
      <div class="hero-bg" style="background-color: #4A5D6E;">
        <div class="hero-placeholder-img">
          <span>材料仓库 · 板材特写</span>
        </div>
      </div>
      <div class="hero-content">
        <p class="hero-eyebrow">环保</p>
        <h2 class="hero-title">绿色制造<br>可持续发展</h2>
        <p class="hero-desc">E0/E1 级环保板材，FSC 认证木材，水性漆工艺，低碳生产全流程</p>
      </div>
    </section>

<!-- PLACEHOLDER_MORE_SECTIONS -->

    <section class="hero-section" data-section="4">
      <div class="hero-bg" style="background-color: #364F60;">
        <div class="hero-placeholder-img">
          <span>办公空间场景 · 开放式办公</span>
        </div>
      </div>
      <div class="hero-content hero-content--right">
        <p class="hero-eyebrow">产品</p>
        <h2 class="hero-title">10 大品类<br>200+ 型号</h2>
        <p class="hero-desc">办公桌、工学椅、储物柜、屏风隔断、协作空间，全场景覆盖</p>
        <a href="/products" class="hero-cta">浏览所有商品</a>
      </div>
    </section>

    <section class="hero-section" data-section="5">
      <div class="hero-bg" style="background-color: #2A3F52;">
        <div class="hero-placeholder-img">
          <span>全球物流 · 欧洲市场</span>
        </div>
      </div>
      <div class="hero-content hero-content--center">
        <p class="hero-eyebrow">出口欧洲</p>
        <h2 class="hero-title">服务全球客户</h2>
        <p class="hero-desc">产品远销 30+ 国家和地区，欧洲市场深耕多年，专业团队提供一站式服务</p>
        <a href="/about" class="hero-cta">了解 Twinco</a>
      </div>
    </section>
  </main>
</BaseLayout>
