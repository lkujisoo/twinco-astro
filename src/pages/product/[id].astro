---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductDetailPage from '../../components/ProductDetailPage.astro';
import AliasRedirect from '../../components/AliasRedirect.astro';
import { DEFAULT_LOCALE, localizePath } from '../../i18n';
import { getProductsByLang } from '../../i18n/product';
import { PRODUCT_ALIASES } from '../../data/product-aliases';

export async function getStaticPaths() {
  const products = await getProductsByLang(DEFAULT_LOCALE);
  return [
    ...products.map((product) => ({
      params: { id: product.id },
      props: { product, aliasTarget: null as string | null },
    })),
    ...Object.entries(PRODUCT_ALIASES).map(([from, to]) => ({
      params: { id: from },
      props: { product: null, aliasTarget: to },
    })),
  ];
}

const lang = DEFAULT_LOCALE;
const { product, aliasTarget } = Astro.props;
---
{aliasTarget ? (
  <AliasRedirect target={`${localizePath(`/product/${aliasTarget}`, lang)}/`} lang={lang} />
) : (
  <BaseLayout title={`${product.name} | Twinco`} bodyClass="page-product-detail" solidHeader={true} lang={lang}>
    <ProductDetailPage lang={lang} product={product} />
  </BaseLayout>
)}
