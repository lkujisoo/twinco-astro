---
const target = '/product/57100/';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Redirecting to 57100 / 57200 TWIN Monitor Arm Series</title>
  </head>
  <body>
    <script is:inline>
      window.location.replace('/product/57100/');
    </script>
    <p><a href={target}>Open 57100 / 57200 TWIN Monitor Arm Series</a></p>
  </body>
</html>
