---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  solidHeader?: boolean;
}

const { title, description = 'Twinco Furniture - Premium quality furniture for modern living', bodyClass = '', solidHeader = false } = Astro.props;
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap" rel="stylesheet">
</head>
<body class={bodyClass}>
  <header class={`site-header ${solidHeader ? 'header-solid' : ''}`} id="siteHeader">
    <div class="header-inner">
      <a href="/" class="logo">
        <span class="logo-text">TWINCO</span>
      </a>
      <nav class="main-nav">
        <a href="/" class="nav-link">首页</a>
        <button class="nav-link" id="productsToggle" aria-expanded="false" aria-controls="megaDropdown">
          <span>所有商品</span>
          <svg class="nav-arrow" width="10" height="6" viewBox="0 0 10 6" fill="none">
            <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <a href="/about" class="nav-link">关于 Twinco</a>
      </nav>
      <div class="header-actions">
        <button class="action-btn" id="searchToggle" aria-label="搜索">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
          </svg>
        </button>
        <div class="lang-switcher" id="langSwitcher">
          <button class="action-btn lang-toggle" aria-label="切换语言" aria-expanded="false">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
          </button>
          <ul class="lang-dropdown" role="menu">
            <li role="menuitem"><a href="#" data-lang="zh" class="active">中文</a></li>
            <li role="menuitem"><a href="#" data-lang="en">English</a></li>
            <li role="menuitem"><a href="#" data-lang="es">Español</a></li>
            <li role="menuitem"><a href="#" data-lang="fr">Français</a></li>
            <li role="menuitem"><a href="#" data-lang="ar">العربية</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="search-overlay" id="searchOverlay">
      <div class="search-bar">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
        </svg>
        <input type="text" id="searchInput" placeholder="搜索产品..." autocomplete="off">
        <button class="search-close" id="searchClose" aria-label="关闭搜索">&times;</button>
      </div>
    </div>

    <div class="mega-dropdown" id="megaDropdown" aria-hidden="true">
      <div class="mega-inner">
        <ul class="mega-categories" id="megaCategories" role="list"></ul>
        <div class="mega-subcategories" id="megaSubcategories">
          <p class="mega-hint">← 点击左侧分类查看子分类</p>
        </div>
      </div>
    </div>
  </header>

  <slot />

  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-brand">
        <span class="logo-text">TWINCO</span>
        <p class="footer-tagline">Premium Furniture Since 2010</p>
      </div>
      <div class="footer-contact">
        <p>info@twinco.com</p>
        <p>+86 XXX-XXXX-XXXX</p>
      </div>
      <div class="footer-links">
        <a href="/about">关于我们</a>
        <a href="/products">所有商品</a>
        <a href="mailto:info@twinco.com">联系我们</a>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; 2026 Twinco Furniture. All rights reserved.</p>
    </div>
  </footer>

  <script is:inline src="/scripts/main.js"></script>
</body>
</html>
