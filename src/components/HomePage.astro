---
import { useTranslations, localizePath } from '../i18n';
import { getCategories } from '../i18n/categories';
import enCategoryNames from '../i18n/categories/en.json';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const p = (path: string) => localizePath(path, lang);
const categories = getCategories(lang);

const heroImages = [
  '/images/hero/hero-01.webp',
  '/images/hero/hero-02.webp',
  '/images/hero/hero-04.webp',
  '/images/hero/hero-07.webp',
  '/images/hero/hero-09-footrest.png',
  '/images/hero/hero-10.webp',
  '/images/hero/hero-11.webp',
  '/images/hero/hero-12.webp'
];
---
<main class="home-page">
  <section class="home-hero" aria-label={t('home.heroAria')}>
    <div class="home-hero-slider" id="homeHeroSlider">
      {heroImages.map((image, index) => (
        <figure class={`home-hero-slide ${index === 0 ? 'active' : ''}`} aria-hidden={index === 0 ? 'false' : 'true'}>
          <img
            src={image}
            alt={t('home.heroAlt', { n: index + 1 })}
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </figure>
      ))}
    </div>

    <div class="home-hero-overlay"></div>

    <div class="home-hero-content">
      <p class="hero-eyebrow">{t('home.eyebrow')}</p>
      <h1 class="hero-title">{t('home.heroTitleLine1')}<br />{t('home.heroTitleLine2')}</h1>
      <p class="hero-desc">{t('home.heroDesc')}</p>
      <a href={p('/products')} class="hero-cta">{t('home.heroCta')}</a>
    </div>

    <button class="home-hero-arrow home-hero-arrow--prev" type="button" aria-label={t('home.heroPrev')} data-hero-prev>
      <svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M15 18 9 12l6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
    <button class="home-hero-arrow home-hero-arrow--next" type="button" aria-label={t('home.heroNext')} data-hero-next>
      <svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true">
        <path d="m9 18 6-6-6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    <div class="home-hero-dots" aria-label={t('home.heroDotsAria')}>
      {heroImages.map((_, index) => (
        <button
          class={`home-hero-dot ${index === 0 ? 'active' : ''}`}
          type="button"
          aria-label={t('home.heroDotAria', { n: index + 1 })}
          aria-current={index === 0 ? 'true' : 'false'}
          data-hero-dot={index}
        ></button>
      ))}
    </div>
  </section>

  <section class="home-categories" id="section-2" aria-labelledby="homeCategoriesTitle">
    <div class="home-section-head">
      <p class="home-section-kicker">{t('home.catKicker')}</p>
      <h2 class="home-section-title" id="homeCategoriesTitle">{t('home.catTitleLine1')}<br />{t('home.catTitleLine2')}</h2>
      <p class="home-section-desc">{t('home.catDesc')}</p>
    </div>

    <div class="home-category-grid">
      {categories.map((category) => {
        const firstImage = category.subcategories.find((sub) => sub.thumbnail)?.thumbnail;
        const subCount = category.subcategories.length;
        const englishName = enCategoryNames[category.id as keyof typeof enCategoryNames];
        return (
          <a class="home-category-card" href={`${p('/products')}?category=${category.id}`}>
            <div class="home-category-image">
              {firstImage ? (
                <img src={firstImage} alt={category.name} loading="lazy" decoding="async" />
              ) : (
                <span>{category.name.slice(0, 1)}</span>
              )}
            </div>
            <div class="home-category-copy">
              <h3>{category.name}</h3>
              {englishName !== category.name && <p>{englishName}</p>}
              <span>{t('home.subCount', { n: subCount })}</span>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <section class="home-brand-band">
    <div class="home-brand-copy">
      <p class="home-section-kicker">{t('home.qualityKicker')}</p>
      <h2 class="home-section-title">{t('home.qualityTitleLine1')}<br />{t('home.qualityTitleLine2')}</h2>
      <p class="home-section-desc">{t('home.qualityDesc')}</p>
    </div>
    <div class="home-brand-copy">
      <p class="home-section-kicker">{t('home.exportKicker')}</p>
      <h2 class="home-section-title">{t('home.exportTitle')}</h2>
      <p class="home-section-desc">{t('home.exportDesc')}</p>
    </div>
  </section>
</main>
